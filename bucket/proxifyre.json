{
    "version": "2.6.1",
    "description": "A Windows SOCKS5 proxifier leveraging NDISAPI to transparently route TCP and UDP traffic on a per-app basis.",
    "homepage": "https://github.com/wiresock/proxifyre",
    "license": "AGPL-3.0",
    "depends": "ndisapi-np",
    "architecture": {
        "64bit": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.6.1/ProxiFyre-2.6.1-win-x64.msi",
            "hash": "39e1831954c4d5b2d61edd8d91a3114baada31ddf484ee2110a1d9a8ba593623"
        },
        "32bit": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.6.1/ProxiFyre-2.6.1-win-x86.msi",
            "hash": "cc0c24cf57dfbbf02a1d39a0a343c03e82c7023b3f4d894a1c99cb5252553de3"
        },
        "arm64": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.6.1/ProxiFyre-2.6.1-win-arm64.msi",
            "hash": "2c8acff64d47c2444ab37030e9fce63f00c49217b226838c421b5ad3304d02ff"
        }
    },
    "extract_dir": "PFiles64/ProxiFyre",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\app-config.json\")) {",
        "    $config = @(",
        "        '{',",
        "        '  \"logLevel\": \"Info\",',",
        "        '  \"bypassLan\": true,',",
        "        '  \"proxies\": [',",
        "        '    {',",
        "        '      \"appNames\": [],',",
        "        '      \"socks5ProxyEndpoint\": \"127.0.0.1:1080\",',",
        "        '      \"supportedProtocols\": [\"TCP\", \"UDP\"]',",
        "        '    }',",
        "        '  ]',",
        "        '}'",
        "    )",
        "    $config | Set-Content \"$persist_dir\\app-config.json\" -Encoding Ascii",
        "}"
    ],
    "bin": "ProxiFyre.exe",
    "shortcuts": [
        [
            "ProxiFyre.exe",
            "ProxiFyre"
        ]
    ],
    "persist": "app-config.json",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-x64.msi"
            },
            "32bit": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-x86.msi"
            },
            "arm64": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-arm64.msi"
            }
        }
    },
    "notes": "GUI mode is not supported in portable manifest. Use proxifyre-np instead (not promised to work)."
}
