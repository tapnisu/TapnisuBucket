{
    "version": "2.7.0",
    "description": "A Windows SOCKS5 proxifier leveraging NDISAPI to transparently route TCP and UDP traffic on a per-app basis.",
    "homepage": "https://github.com/wiresock/proxifyre",
    "license": "AGPL-3.0",
    "depends": "ndisapi-np",
    "architecture": {
        "64bit": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.7.0/ProxiFyre-2.7.0-win-x64.msi",
            "hash": "8238b1a14eab067bee1223440117b9245a8dbd052d59666f5a6af499aead76ac"
        },
        "32bit": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.7.0/ProxiFyre-2.7.0-win-x86.msi",
            "hash": "ec40da97d52328264204eff194a6ae0260a9d628b07bd1675797b3d75b1f59f8"
        },
        "arm64": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.7.0/ProxiFyre-2.7.0-win-arm64.msi",
            "hash": "ae4826041a2573fdd8ccb62d412bd90f520d2ee7cc601feb5c25c057903dfabd"
        }
    },
    "extract_dir": "PFiles64/ProxiFyre",
    "post_install": [
        "$config = \"app-config.json\"",
        "ensure $persist_dir",
        "if (!(Test-Path \"$persist_dir\\$config\")) {",
        "    $default_config = @(",
        "        '{',",
        "        '  \"logLevel\": \"Info\",',",
        "        '  \"bypassLan\": true,',",
        "        '  \"proxies\": [',",
        "        '    {',",
        "        '      \"appNames\": [],',",
        "        '      \"socks5ProxyEndpoint\": \"127.0.0.1:1080\",',",
        "        '      \"supportedProtocols\": [\"TCP\", \"UDP\"]',",
        "        '    }',",
        "        '  ]',",
        "        '}'",
        "    )",
        "    $default_config | Set-Content \"$persist_dir\\$config\" -Encoding Ascii",
        "}",
        "move-item \"$persist_dir\\$config\" \"$dir\""
    ],
    "pre_uninstall": [
        "ensure $persist_dir",
        "move-item \"$dir\\app-config.json\" \"$persist_dir\""
    ],
    "bin": "ProxiFyre.exe",
    "shortcuts": [
        [
            "ProxiFyre.exe",
            "ProxiFyre"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-x64.msi"
            },
            "32bit": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-x86.msi"
            },
            "arm64": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-arm64.msi"
            }
        }
    },
    "notes": "GUI mode is not supported in portable manifest. Use proxifyre-np instead (not promised to work)."
}
