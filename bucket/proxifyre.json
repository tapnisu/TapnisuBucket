{
    "version": "2.6.0",
    "description": "A Windows SOCKS5 proxifier leveraging NDISAPI to transparently route TCP and UDP traffic on a per-app basis.",
    "homepage": "https://github.com/wiresock/proxifyre",
    "license": "AGPL-3.0",
    "depends": "ndisapi-np",
    "architecture": {
        "64bit": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.6.0/ProxiFyre-2.6.0-win-x64.msi",
            "hash": "65ebbe96f9f44b6d97263351664b1165d562ccf8af0068a3b19b6db9111de2b7"
        },
        "32bit": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.6.0/ProxiFyre-2.6.0-win-x86.msi",
            "hash": "cd09dfd56b16c327d047e3fe6b5cb4c663585fdf1c984cfc843c948484acc8fe"
        },
        "arm64": {
            "url": "https://github.com/wiresock/proxifyre/releases/download/v2.6.0/ProxiFyre-2.6.0-win-arm64.msi",
            "hash": "8adf853fea13e5e646792ef7e3bb69492d34f9d83e4f13d71e98a90981bd17e3"
        }
    },
    "extract_dir": "PFiles64/ProxiFyre",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\app-config.json\")) {",
        "    $config = @(",
        "        '{',",
        "        '  \"logLevel\": \"Info\",',",
        "        '  \"bypassLan\": true,',",
        "        '  \"proxies\": [',",
        "        '    {',",
        "        '      \"appNames\": [],',",
        "        '      \"socks5ProxyEndpoint\": \"127.0.0.1:1080\",',",
        "        '      \"supportedProtocols\": [\"TCP\", \"UDP\"]',",
        "        '    }',",
        "        '  ]',",
        "        '}'",
        "    )",
        "    $config | Set-Content \"$persist_dir\\app-config.json\" -Encoding Ascii",
        "}"
    ],
    "bin": "ProxiFyre.exe",
    "shortcuts": [
        [
            "ProxiFyre.exe",
            "ProxiFyre"
        ]
    ],
    "persist": "app-config.json",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-x64.msi"
            },
            "32bit": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-x86.msi"
            },
            "arm64": {
                "url": "https://github.com/wiresock/proxifyre/releases/download/v$version/ProxiFyre-$version-win-arm64.msi"
            }
        }
    },
    "notes": "GUI mode is not supported."
}
